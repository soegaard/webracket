const faslFixnumMin = -(1 << 29);
const faslFixnumMax = (1 << 29) - 1;
const faslBigIntZero = hostBigIntForFasl(0);
const faslBigIntOne = hostBigIntForFasl(1);
const faslBigIntThirtyTwo = hostBigIntForFasl(32);
const faslBigIntU32Mask = hostBigIntForFasl(0xFFFFFFFF);
const faslFixnumMinBig = hostBigIntForFasl(faslFixnumMin);
const faslFixnumMaxBig = hostBigIntForFasl(faslFixnumMax);

function utf8_encode_string(s) {
  return hostTextEncoderEncodeForUtf8.call(hostTextEncoderInstanceForUtf8, hostStringForBridge(s));
}

function utf8_decode_bytes(bytes) {
  return hostTextDecoderDecodeForUtf8.call(hostTextDecoderInstanceForUtf8, bytes);
