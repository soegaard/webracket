(define-runtime-path runtime-js-imports-path "runtime-js/imports.js")

;; Register the generated-host source with Racket's compilation manager, so a
;; normal `raco make` rebuilds this assembler whenever the injected JavaScript
;; changes.
(begin-for-syntax
  (define-runtime-path runtime-js-imports-path "runtime-js/imports.js")
  (register-external-file runtime-js-imports-path))

;; runtime-js-imports : string?
;;   JavaScript host imports spliced into generated Node/browser runtimes.
(define runtime-js-imports
  (file->string runtime-js-imports-path))

;;;
;;; ASSEMBLER
;;;

; The assembler takes a WebAssembly program in the folded textual format (.wat)
; and produces a binary (.wasm).

; Currently we use an external tool `wasm-tools` from the Bytecode Alliance.

; The host file (default: runtime.js) is also generated by the assembler.


;;; USAGE

;; (run [x #f] 
;;      #:wat        [out.wat    "out.wat"]
;;      #:wasm       [out.wasm   "out.wasm"]
;;      #:runtime.js [runtime.js "runtime.js"])

;; (wat->wasm x
;;            #:wat [out.wat "out.wat"]
;;            #:wasm [out.wasm "out.wasm"]
;;            #:exec-path-from-shell? [exec-path-from-shell? #t])


;;;
;;; TODO
;;;

; Some of the comments below refer to the external tool `wabt` but
; as it turns out, it does not support the GC proposal.


;;;
;;; NOTES
;;; 

;; We are using an external assembler to compile wat files into
;; wasm bytecode.

; The chosen assembler is `wasm-tools` which is a Rust project.
; There are prebuilt binaries in the release assets:
;
;     https://github.com/bytecodealliance/wasm-tools/releases
;
; The current version is 1.230.0 (May 2025).

; List the available commands:
;    ./wasm-tools
; Help for the `parse` tool:
;  ./wasm-tools parse --help
; The `parse` tool converts from the textual format (wat) to
; the binary format (wasm). 


;; Alternatives

; The assembler `wat2wasm` from the "official" wabt tools
; does not support the GC proposal (which includes i31).
; The tool has a flag `--enable-gc` but it has no effect on the assembler.
; The issue is that the options are shared between a set of tools,
; and some of the other tools support the GC proposal.


;; search-path-separator : -> string?
;;   Return the platform-specific separator for PATH-like variables.
(define (search-path-separator)
  (if (eq? (system-path-convention-type) 'windows) ";" ":"))

;; append-inherited-search-path : (or/c string? #f) (or/c string? #f) -> (or/c string? #f)
;;   Append a login-shell search path without displacing inherited entries.
(define (append-inherited-search-path inherited shell)
  (cond
    [(not inherited) shell]
    [(not shell) inherited]
    [(string=? inherited shell) inherited]
    [else (string-append inherited (search-path-separator) shell)]))

;; merge-inherited-search-path! : string? (or/c string? #f) -> void?
;;   Keep inherited PATH-like entries ahead of a newly imported shell value.
(define (merge-inherited-search-path! name inherited)
  (define shell (getenv name))
  (define merged (append-inherited-search-path inherited shell))
  (when (and merged (not (equal? merged shell)))
    (putenv name merged)))

;; initialize-assembler-environment! : [#:exec-path-from-shell? boolean?] -> void?
;;   Import login-shell search paths once, preserving inherited PATH precedence.
(define assembler-environment-initialized? #f)

(define (initialize-assembler-environment! #:exec-path-from-shell? [exec-path-from-shell? #t])
  (when (and exec-path-from-shell?
             (not assembler-environment-initialized?))
    (define inherited-path    (getenv "PATH"))
    (define inherited-manpath (getenv "MANPATH"))
    (exec-path-from-shell-initialize)
    (merge-inherited-search-path! "PATH" inherited-path)
    (merge-inherited-search-path! "MANPATH" inherited-manpath)
    (set! assembler-environment-initialized? #t)))

;; path-string->system-argument : path-string? -> string?
;;   Convert a path string to a subprocess argument.
(define (path-string->system-argument p)
  (cond [(path? p)   (path->string p)]
        [(string? p) p]
        [else        (raise-argument-error 'path-string->system-argument
                                           "path-string?"
                                           p)]))

;; find-executable-with-shell-fallback : string? boolean? (string? -> (or/c path? #f)) (-> void?) -> (or/c path? #f)
;;   Prefer an inherited executable, using the login shell only as a fallback.
(define (find-executable-with-shell-fallback executable-name
                                             exec-path-from-shell?
                                             find-executable
                                             initialize-environment!)
  (or (find-executable executable-name)
      (and exec-path-from-shell?
           (begin
             (initialize-environment!)
             (find-executable executable-name)))))

;; raise-missing-executable : symbol? string? string? -> none/c
;;   Report that neither the inherited nor fallback search found an executable.
(define (raise-missing-executable who executable-name instruction)
  (error who
         (string-append
          "required executable `" executable-name "` was not found in PATH.\n"
          instruction)))

;; wasm-tools-executable : [#:who symbol?] [#:missing-purpose string?] [#:exec-path-from-shell? boolean?] -> path?
;;   Locate wasm-tools with the inherited PATH first and report a useful error.
(define (wasm-tools-executable #:who [who 'wat->wasm]
                               #:missing-purpose [missing-purpose
                                                  "compile `.wat` files to `.wasm`"]
                               #:exec-path-from-shell? [exec-path-from-shell? #t])
  (or (find-executable-with-shell-fallback
       "wasm-tools"
       exec-path-from-shell?
       find-executable-path
       (lambda ()
         (initialize-assembler-environment! #:exec-path-from-shell? #t)))
      (raise-missing-executable
       who
       "wasm-tools"
       (string-append "Install `wasm-tools` to " missing-purpose "."))))

;; node-executable : [#:who symbol?] [#:exec-path-from-shell? boolean?] -> path?
;;   Locate Node.js with the inherited PATH first and report a useful error.
(define (node-executable #:who [who 'run]
                         #:exec-path-from-shell? [exec-path-from-shell? #t])
  (or (find-executable-with-shell-fallback
       "node"
       exec-path-from-shell?
       find-executable-path
       (lambda ()
         (initialize-assembler-environment! #:exec-path-from-shell? #t)))
      (raise-missing-executable
       who
       "node"
       "Install Node.js or run without `-r`.")))

(module+ test
  (test-case "login-shell paths preserve inherited precedence"
    (define inherited-path "inherited PATH")
    (define shell-path "login shell PATH")
    (check-equal?
     (append-inherited-search-path inherited-path shell-path)
     (string-append inherited-path (search-path-separator) shell-path))
    (check-equal? (append-inherited-search-path inherited-path #f)
                  inherited-path)
    (check-equal? (append-inherited-search-path #f shell-path)
                  shell-path)
    (check-equal? (append-inherited-search-path inherited-path inherited-path)
                  inherited-path))

  (test-case "wasm-tools discovery preserves an inherited PATH"
    (define inherited-path "inherited PATH")
    (define current-path inherited-path)
    (define initialized? #f)
    (define inherited-wasm-tools
      (build-path (current-directory) "inherited-wasm-tools"))
    (define found
      (find-executable-with-shell-fallback
       "wasm-tools"
       #t
       (lambda (name)
         (and (string=? name "wasm-tools")
              (equal? current-path inherited-path)
              inherited-wasm-tools))
       (lambda ()
         (set! initialized? #t)
         (set! current-path "login shell PATH"))))
    (check-equal? found inherited-wasm-tools)
    (check-equal? current-path inherited-path)
    (check-false initialized?))

  (test-case "node discovery falls back to the login shell"
    (define current-path "inherited PATH without node")
    (define initialization-count 0)
    (define shell-node
      (build-path (current-directory) "shell-node"))
    (define found
      (find-executable-with-shell-fallback
       "node"
       #t
       (lambda (name)
         (and (string=? name "node")
              (equal? current-path "login shell PATH")
              shell-node))
       (lambda ()
         (set! initialization-count (add1 initialization-count))
         (set! current-path "login shell PATH"))))
    (check-equal? found shell-node)
    (check-equal? initialization-count 1))

  (test-case "wasm fallback does not hide an inherited Node executable"
    (define inherited-path "inherited PATH")
    (define shell-path "login shell PATH")
    (define current-path inherited-path)
    (define inherited-node
      (build-path (current-directory) "inherited-node"))
    (define shell-wasm-tools
      (build-path (current-directory) "shell-wasm-tools"))
    (define (find-executable name)
      (cond
        [(and (string=? name "node")
              (string-prefix? current-path inherited-path))
         inherited-node]
        [(and (string=? name "wasm-tools")
              (string=? current-path
                        (append-inherited-search-path inherited-path shell-path)))
         shell-wasm-tools]
        [else #f]))
    (define (initialize!)
      (set! current-path
            (append-inherited-search-path inherited-path shell-path)))
    (check-equal?
     (find-executable-with-shell-fallback
      "wasm-tools" #t find-executable initialize!)
     shell-wasm-tools)
    (check-equal?
     (find-executable-with-shell-fallback
      "node" #t find-executable initialize!)
     inherited-node))

  (test-case "disabled login-shell lookup leaves the inherited environment alone"
    (define current-path "inherited PATH without wasm-tools")
    (define initialized? #f)
    (check-false
     (find-executable-with-shell-fallback
      "wasm-tools"
      #f
      (lambda (_) #f)
      (lambda ()
        (set! initialized? #t)
        (set! current-path "login shell PATH"))))
    (check-equal? current-path "inherited PATH without wasm-tools")
    (check-false initialized?))

  (test-case "missing wasm-tools reports a clear error after fallback"
    (define initialization-count 0)
    (check-false
     (find-executable-with-shell-fallback
      "wasm-tools"
      #t
      (lambda (_) #f)
      (lambda ()
        (set! initialization-count (add1 initialization-count)))))
    (check-equal? initialization-count 1)
    (check-exn
     (lambda (e)
       (and (exn:fail? e)
            (string-contains?
             (exn-message e)
             "required executable `wasm-tools` was not found in PATH.")
            (string-contains? (exn-message e) "Install `wasm-tools`")))
     (lambda ()
       (raise-missing-executable
        'wasm-tools-test
        "wasm-tools"
        "Install `wasm-tools` to compile `.wat` files to `.wasm`.")))))


;;;
;;; RUNTIME
;;;

;; The runtimes generated for Node and browsers are the mostly identical.
;; The only difference is that Node uses `fs.readFile` to load the wasm
;; and the browser needs to fetch it.

(define (split-core-runtime-instantiation core-buffer-name
                                          #:provider-imports-from-core?
                                          [provider-imports-from-core? #f]
                                          #:initialize-core?
                                          [initialize-core? #f])
  (cond
    [core-buffer-name
     @~a{const coreRuntimeModule = await hostWebAssembly.compile(@|core-buffer-name|);
assert_ffi_exception_bridge_visible_imports(coreRuntimeModule, imports, "split core runtime");
const coreRuntimeInstance = await hostWebAssembly.instantiate(coreRuntimeModule, imports);
splitRuntimeCoreExports = coreRuntimeInstance.exports;
imports["core"] = splitRuntimeCoreExports;
@|(if provider-imports-from-core?
      "imports[\"provider\"] = splitRuntimeCoreExports;\n"
      "")|@|(if initialize-core?
              @~a{splitRuntimeCoreExports["$initialize-split-runtime-before-constants!"]();
splitRuntimeCoreExports["$initialize-split-runtime-constants!"]();
splitRuntimeCoreExports["$initialize-split-runtime-after-constants!"]();
splitRuntimeCoreExports["$initialize-unsafe-ffi-primitive-table"]();
splitRuntimeCoreExports["$initialize-split-runtime-after-ffi!"]();
}
              "")|

}]
    [(or provider-imports-from-core? initialize-core?)
     (error 'runtime
            "core provider options require a split runtime core output")]
    [else ""]))

(define (split-core-provider-entry-call core-buffer-name provider-entry)
  (cond
    [(and core-buffer-name provider-entry)
     @~a{splitRuntimeCoreExports[@|(jsexpr->string provider-entry)|]();

}]
    [provider-entry
     (error 'runtime
            "core provider entry requires a split runtime core output")]
    [else ""]))

(define (split-ffi-runtime-instantiation ffi-buffer-name)
  (if ffi-buffer-name
      @~a{const ffiRuntimeModule = await hostWebAssembly.compile(@|ffi-buffer-name|);
assert_ffi_exception_bridge_visible_imports(ffiRuntimeModule, imports, "split FFI runtime");
const ffiRuntimeInstance = await hostWebAssembly.instantiate(ffiRuntimeModule, imports);
const splitRuntimeFfiExports = ffiRuntimeInstance.exports;
imports["ffi"] = splitRuntimeFfiExports;
const splitRuntimeFfiInitializer = splitRuntimeFfiExports["$initialize-split-ffi-sidecar-primitives!"];
if (typeof splitRuntimeFfiInitializer === "function") {
  splitRuntimeFfiInitializer();
}

}
      ""))

(define (runtime-common #:console-bridge? [console-bridge? #f]
                        #:browser?        [browser? #f]
                        #:core-buffer-name [core-buffer-name #f]
                        #:ffi-buffer-name [ffi-buffer-name #f]
                        #:core-provider-imports-from-core?
                        [core-provider-imports-from-core? #f]
                        #:core-initialize? [core-initialize? #f]
                        #:core-provider-entry [core-provider-entry #f])
  (when (and ffi-buffer-name (not core-buffer-name))
    (error 'runtime "FFI sidecar output requires a split runtime core output"))
	@~a{
const hostWebAssembly = typeof WebAssembly === 'undefined' ? null : WebAssembly;
const hostWebAssemblyTag = hostWebAssembly && hostWebAssembly.Tag;
const hostWebAssemblyException = hostWebAssembly && hostWebAssembly.Exception;
const hostWebAssemblyModule = hostWebAssembly && hostWebAssembly.Module;
const hostSymbol = typeof Symbol === 'undefined' ? null : Symbol;
const hostSymbolFor = hostSymbol && typeof hostSymbol.for === 'function'
  ? hostSymbol.for.bind(hostSymbol)
  : null;
const hostSymbolKeyFor = hostSymbol && typeof hostSymbol.keyFor === 'function'
  ? hostSymbol.keyFor.bind(hostSymbol)
  : null;
const hostSymbolToPrimitive = hostSymbol && hostSymbol.toPrimitive;
const hostStringForBridge = typeof String === 'undefined' ? null : String;
const hostNumberForFasl = typeof Number === 'undefined' ? null : Number;
const hostBigIntForFasl = typeof BigInt === 'undefined' ? null : BigInt;
const hostArrayFromForFasl = typeof hostArray.from === 'function'
  ? hostArray.from.bind(hostArray)
  : null;
const hostArrayIsArrayForFasl = typeof hostArray.isArray === 'function'
