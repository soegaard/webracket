       }
       const @|buffer-name| = await @|label|WasmResponse.arrayBuffer();
       const @|label|WasmBytes = new hostUint8Array(@|buffer-name|);
       const is@|label|WasmMagic =
         @|label|WasmBytes.length >= 4 &&
         @|label|WasmBytes[0] === 0x00 &&
         @|label|WasmBytes[1] === 0x61 &&
         @|label|WasmBytes[2] === 0x73 &&
         @|label|WasmBytes[3] === 0x6d;
       if (!is@|label|WasmMagic) {
         throw new Error(
           `Fetched @|label| wasm '${@|label|WasmUrl}' but content is not a WebAssembly binary (missing magic 00 61 73 6d).`
         );
       }
       }
      ""))

(define (browser-core-wasm-loader core-out)
  (browser-sidecar-wasm-loader "core" core-out "coreWasmBuffer"))

(define (browser-runtime out.wasm
                         #:core-out [core-out #f]
                         #:ffi-out [ffi-out #f]
                         #:core-provider-imports-from-core?
                         [core-provider-imports-from-core? #f]
                         #:core-initialize? [core-initialize? #f]
                         #:core-provider-entry [core-provider-entry #f]
                         #:console-bridge? [console-bridge? #f]
                         #:vfs-preloads [vfs-preloads '()]
                         #:vfs-mounts [vfs-mounts '()])
  @~a{<!DOCTYPE html>
     <html>
     <head><meta charset="UTF-8"/></head>
     <body>
	       <script type="module">
	       // Generated by "assembler.rkt".
	       console.log('WebRacket browser runtime starting');
	       const hostArray = Array;
	       const hostUint8Array = Uint8Array;
	       const hostUint8ArrayFrom = typeof hostUint8Array.from === 'function'
	         ? hostUint8Array.from.bind(hostUint8Array)
	         : null;
	       const hostUint8ArrayPrototype = hostUint8Array && hostUint8Array.prototype;
	       const hostUint8ArraySlice = hostUint8ArrayPrototype && hostUint8ArrayPrototype.slice;
	       const hostUint8ArraySet = hostUint8ArrayPrototype && hostUint8ArrayPrototype.set;
	       if (!hostUint8ArrayFrom ||
	           typeof hostUint8ArraySlice !== 'function' ||
	           typeof hostUint8ArraySet !== 'function') {
	           throw new Error('WebRacket requires Uint8Array from/slice/set.');
	       }
	       const wasmUrl = "@|out.wasm|";
       const wasmResponse = await fetch(wasmUrl);
       if (!wasmResponse.ok) {
         const isAbsolutePath = wasmUrl.startsWith("/");
         const hint = isAbsolutePath
           ? "Likely cause: HTML was generated using an absolute input path. Rebuild from the output directory so the URL is relative (e.g. test-browser.wasm)."
           : "Check that the program .wasm file exists next to this .html file and is served by your web server.";
         throw new Error(
           `Failed to fetch wasm '${wasmUrl}' (HTTP ${wasmResponse.status} ${wasmResponse.statusText}). ${hint}`
         );
       }
       const wasmBuffer = await wasmResponse.arrayBuffer();
       const wasmBytes = new hostUint8Array(wasmBuffer);
       const isWasmMagic =
         wasmBytes.length >= 4 &&
         wasmBytes[0] === 0x00 &&
         wasmBytes[1] === 0x61 &&
         wasmBytes[2] === 0x73 &&
         wasmBytes[3] === 0x6d;
       if (!isWasmMagic) {
         throw new Error(
           `Fetched '${wasmUrl}' but content is not a WebAssembly binary (missing magic 00 61 73 6d). ` +
           "Likely cause: server returned HTML (for example a 404 page) instead of .wasm."
         );
       }
       @|(browser-core-wasm-loader core-out)|
       @|(browser-sidecar-wasm-loader "ffi" ffi-out "ffiWasmBuffer")|
       @|(vfs-mount-manifest-assignment vfs-mounts)|
       @|(vfs-preload-manifest-assignment vfs-preloads)|
       @(runtime-common #:console-bridge? console-bridge? #:browser? #t
                        #:core-buffer-name (and core-out "coreWasmBuffer")
                        #:ffi-buffer-name (and ffi-out "ffiWasmBuffer")
                        #:core-provider-imports-from-core?
                        core-provider-imports-from-core?
                        #:core-initialize? core-initialize?
                        #:core-provider-entry core-provider-entry)
       </script>
     </body>
     </html>
})

(define (runtime #:out  [out.wasm "out.wasm"]
                 #:core-out [core-out #f]
                 #:ffi-out [ffi-out #f]
                 #:core-provider-imports-from-core?
                 [core-provider-imports-from-core? #f]
                 #:core-initialize? [core-initialize? #f]
                 #:core-provider-entry [core-provider-entry #f]
                 #:host [host 'node]
                 #:console-bridge? [console-bridge? #f]
                 #:vfs-preloads [vfs-preloads '()]
                 #:vfs-mounts [vfs-mounts '()])
  (validate-vfs-manifest-interactions! vfs-preloads vfs-mounts)
  (case host
    [(node)
     (node-runtime out.wasm
                   #:core-out core-out
                   #:ffi-out ffi-out
                   #:core-provider-imports-from-core?
                   core-provider-imports-from-core?
                   #:core-initialize? core-initialize?
                   #:core-provider-entry core-provider-entry
                   #:console-bridge? console-bridge?
                   #:vfs-preloads vfs-preloads
                   #:vfs-mounts vfs-mounts)]
    [(browser)
     (browser-runtime out.wasm
                      #:core-out core-out
                      #:ffi-out ffi-out
                      #:core-provider-imports-from-core?
                      core-provider-imports-from-core?
                      #:core-initialize? core-initialize?
                      #:core-provider-entry core-provider-entry
                      #:console-bridge? console-bridge?
                      #:vfs-preloads vfs-preloads
                      #:vfs-mounts vfs-mounts)]
    [else      (error 'runtime (format "unknown host ~a" host))]))

