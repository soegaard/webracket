function flonum_to_racket_string(x) {
  if (Number.isNaN(x)) return '+nan.0';
  if (x === Infinity) return '+inf.0';
  if (x === -Infinity) return '-inf.0';
  if (Object.is(x, -0)) return '-0.0';

  const s = String(x);
  return /[.eE]/.test(s) ? s : `${s}.0`;
}

